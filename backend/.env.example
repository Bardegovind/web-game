# ---- Database ----
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/myapp

# ---- Identity ----
# Two accounts, two passwords. Set USER_A_PASSWORD to whatever MASTER_PASSWORD
# is today and her login is unchanged — same screen, same password.
#
# Leave these unset and the app keeps the old shared-password behaviour, where
# the password alone lets anyone sign in under any name.
USER_A_NAME=
USER_A_PASSWORD=
USER_B_NAME=
USER_B_PASSWORD=

# Legacy shared password. Still used when the four variables above are unset.
MASTER_PASSWORD=

# ---- Tokens ----
JWT_SECRET=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Server ----
PORT=5000
# Comma-separated origins allowed to call the API. Unset means same-origin only,
# which is correct while the frontend is served by this process.
ALLOWED_ORIGINS=

# ---- Scaling (optional) ----
# Only needed with more than one backend instance. Absent, Socket.IO uses its
# in-memory adapter and everything works on a single process.
REDIS_URL=

# ---- Push notifications (optional, needs HTTPS) ----
# Generate with: npx web-push generate-vapid-keys
# Until both are set the notifier records intent and sends nothing, rather than
# pretending to deliver.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
